+  switch (record->type) {
+    case ROCTRACER_ACTIVITY_DEFAULT:
+      handleRuntimeActivity(
+          reinterpret_cast<const roctracerRow*>(record), logger);
+      break;
+    case ROCTRACER_ACTIVITY_KERNEL:
