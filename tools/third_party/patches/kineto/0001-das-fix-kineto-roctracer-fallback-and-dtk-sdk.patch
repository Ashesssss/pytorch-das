+  HIP_OP_COPY_KIND_DEVICE_TO_DEVICE_2D_ = 0x1203,
+  HIP_OP_COPY_KIND_FILL_BUFFER_ = 0x1207
+} hip_op_copy_kind_t_;
+
+typedef enum {
+  HIP_OP_DISPATCH_KIND_UNKNOWN_ = 0,
+  HIP_OP_DISPATCH_KIND_KERNEL_ = 0x11F0,
+  HIP_OP_DISPATCH_KIND_TASK_ = 0x11F1
