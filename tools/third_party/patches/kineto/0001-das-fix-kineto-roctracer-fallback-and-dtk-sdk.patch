+  HIP_OP_COPY_KIND_DEVICE_TO_HOST_ = 0x11F3,
+  HIP_OP_COPY_KIND_HOST_TO_DEVICE_ = 0x11F4,
+  HIP_OP_COPY_KIND_DEVICE_TO_DEVICE_ = 0x11F5,
