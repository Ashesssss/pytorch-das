+// gfx938 (Hygon HCU) has no MFMA; its fp8 matrix instruction is
+// __builtin_hcu_mmac_f32_16x16x32_fp8_fp8 (OCP e4m3). Operand layout matches
+// MFMA 16x16x32, but the result layout is lane l, reg i -> D[l % 16][l / 16 + 4 * i]
+// instead of C[4 * (l / 16) + i][l % 16]. The helpers below reproduce the MFMA
+// register layouts so the rest of CK is unchanged.
+namespace hcu_mma {
+typedef int hcu_int2_t __attribute__((vector_size(8)));
+typedef float hcu_float4_t __attribute__((ext_vector_type(4)));
+typedef float hcu_float16_t __attribute__((ext_vector_type(16)));
+
+__device__ inline int shfl(int v, int src_lane)
+{
+    return __builtin_amdgcn_ds_bpermute(src_lane << 2, v);
+}
+
+__device__ inline float shfl(float v, int src_lane)
+{
+    return __builtin_bit_cast(float,
+                              __builtin_amdgcn_ds_bpermute(src_lane << 2, __builtin_bit_cast(int, v)));
+}
+
+// Same register layout as __builtin_amdgcn_mfma_f32_16x16x32_fp8_fp8.
+// Swapping A/B transposes the result; permuting A rows by (g + 4i) -> (4g + i)
+// turns the strided result layout into the MFMA one.
+__device__ inline hcu_float4_t mfma_f32_16x16x32_fp8_fp8(hcu_int2_t a, hcu_int2_t b, hcu_float4_t c)
+{
+    const int lane = __lane_id();
+    const int src  = (lane & ~15) | ((lane & 3) << 2) | ((lane >> 2) & 3);
+    hcu_int2_t a_perm;
+    a_perm[0] = shfl(a[0], src);
+    a_perm[1] = shfl(a[1], src);
+    return __builtin_hcu_mmac_f32_16x16x32_fp8_fp8(b, a_perm, c);
+}
+
+// Same register layout as __builtin_amdgcn_mfma_f32_32x32x16_fp8_fp8, emulated
+// with four 16x16x32 instructions (K = 16 placed in lanes 0-31, lanes 32-63 zero).
+__device__ inline hcu_float16_t mfma_f32_32x32x16_fp8_fp8(hcu_int2_t a, hcu_int2_t b, hcu_float16_t c)
+{
+    const int lane          = __lane_id();
+    const bool k_lo         = lane < 32;
+    const hcu_float4_t zero = {0.f, 0.f, 0.f, 0.f};
+
+    // Split the 32 rows of A / B into two 16-row blocks in 16x16x32 operand layout.
+    hcu_int2_t a_blk[2], b_blk[2];
+    for(int blk = 0; blk < 2; ++blk)
+    {
+        const int src  = ((lane >> 4) & 1) * 32 + blk * 16 + (lane & 15);
+        const int a0   = shfl(a[0], src);
+        const int a1   = shfl(a[1], src);
+        const int b0   = shfl(b[0], src);
+        const int b1   = shfl(b[1], src);
+        a_blk[blk][0] = k_lo ? a0 : 0;
+        a_blk[blk][1] = k_lo ? a1 : 0;
+        b_blk[blk][0] = k_lo ? b0 : 0;
+        b_blk[blk][1] = k_lo ? b1 : 0;
+    }
+
+    hcu_float4_t r[2][2];
+    for(int mb = 0; mb < 2; ++mb)
+        for(int nb = 0; nb < 2; ++nb)
+            r[mb][nb] = mfma_f32_16x16x32_fp8_fp8(a_blk[mb], b_blk[nb], zero);
+
+    // MFMA 32x32 result: lane l, reg 4g + i -> C[8g + 4(l / 32) + i][l % 32]
+    const bool n_hi = (lane >> 4) & 1;
+    for(int g = 0; g < 4; ++g)
+    {
+        const int mb  = g >> 1;
+        const int src = 16 * (2 * (g & 1) + (lane >> 5)) + (lane & 15);
+        for(int i = 0; i < 4; ++i)
+        {
+            const float v0 = shfl(r[mb][0][i], src);
+            const float v1 = shfl(r[mb][1][i], src);
+            c[4 * g + i] += n_hi ? v1 : v0;
+        }
+    }
+    return c;
+}
+} // namespace hcu_mma
